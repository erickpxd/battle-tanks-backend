@host = http://localhost:5063
@token = replace_with_jwt
@roomId = replace_with_room_id
@playerId = replace_with_player_id

### Health
GET {{host}}/health
Accept: application/json

### Register
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "tank_commander",
  "email": "commander@battletanks.local",
  "password": "Secret123!",
  "displayName": "Commander"
}

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "tank_commander",
  "password": "Secret123!"
}

### Me
GET {{host}}/api/auth/me
Authorization: Bearer {{token}}

### Create room
POST {{host}}/api/rooms
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Desert Arena",
  "maxPlayers": 4,
  "nickname": "Commander"
}

### List rooms
GET {{host}}/api/rooms
Authorization: Bearer {{token}}

### Get room
GET {{host}}/api/rooms/{{roomId}}
Authorization: Bearer {{token}}

### Update room
PUT {{host}}/api/rooms/{{roomId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Desert Arena Updated",
  "maxPlayers": 4,
  "status": "Waiting"
}

### Join room
POST {{host}}/api/rooms/{{roomId}}/join
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nickname": "GuestTank"
}

### List players
GET {{host}}/api/rooms/{{roomId}}/players
Authorization: Bearer {{token}}

### Update player
PUT {{host}}/api/rooms/{{roomId}}/players/{{playerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nickname": "Commander",
  "team": "Blue",
  "health": 100,
  "maxHealth": 100,
  "score": 10
}

### Leave room
POST {{host}}/api/rooms/{{roomId}}/leave
Authorization: Bearer {{token}}

### Delete player
DELETE {{host}}/api/rooms/{{roomId}}/players/{{playerId}}
Authorization: Bearer {{token}}

### Delete room
DELETE {{host}}/api/rooms/{{roomId}}
Authorization: Bearer {{token}}
