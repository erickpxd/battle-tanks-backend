{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "BattleTanks-SuperSecret-JWT-Key-ChangeInProduction-Min32Chars!",
    "Issuer": "BattleTanksApi",
    "Audience": "BattleTanksClient",
    "ExpirationInMinutes": 60
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "battle-tanks-backend",
    "Username": "battle-tanks-backend",
    "WebSocketUrl": "ws://localhost:8083/mqtt",
    "UseTls": false,
    "ReconnectDelaySeconds": 5
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false",
    "MaxEventsPerRoom": 100,
    "HistoryTtlMinutes": 60
  }
}
